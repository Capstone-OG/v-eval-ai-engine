{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=postgres;Username=YOUR_POSTGRES_USER;Password=YOUR_POSTGRES_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "AiSettings": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "OpenAiModels": [
      "gpt-4o",
      "gpt-4o-mini",
      "o3-mini",
      "chatgpt-4o-latest"
    ],
    "GeminiApiKey": "YOUR_GEMINI_API_KEY",
    "GeminiApiKeys": [
      "YOUR_GEMINI_API_KEY"
    ],
    "GeminiModels": [
      "gemini-flash-lite-latest",
      "gemini-3.5-flash-lite",
      "gemini-3.1-flash-lite",
      "gemini-3.8-flash",
      "gemini-3.6-flash"
    ],
    "MaxAttempts": 5,
    "MinQuestionThreshold": 50,
    "ExamParserTimeoutMinutes": 8,
    "TextbookParserTimeoutMinutes": 10
  }
}
