    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>V_Eval_Ai_Engine.API</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../grpc/ai.proto" GrpcServices="Server" Link="Protos/ai.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\V-Eval-Ai_Engine.Infrastructure\V-Eval-Ai_Engine.Infrastructure.csproj" />
    <ProjectReference Include="..\V-Eval-Ai_Engine.Application\V-Eval-Ai_Engine.Application.csproj" />
  </ItemGroup>

</Project>
