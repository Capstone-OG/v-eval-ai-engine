# Build results
bin/
obj/
.vs/
.idea/
*.user
*.suo

# Ignore sensitive appsettings & environment configuration files in production
**/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
**/.env
**/.env.*
!**/.env.example
**/*.bak

# Uploaded test and preview files
**/wwwroot/uploads/**
!**/wwwroot/uploads/.gitkeep
**/wwwroot/extracted_images/*
!**/wwwroot/extracted_images/.gitkeep

# Test results and Coverage reports
TestResults/
[Tt]est[Rr]esults/
*.cobertura.xml
