# ============================================================
# Conversational RAG — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# ============================================================

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# PostgreSQL + pgvector connection string (required)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres.zwxavhoszodmagisoiqu:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# API Server Settings (optional)
API_HOST=0.0.0.0
API_PORT=8000


# Knowledge Graph (GraphRAG Core Flow 4) - Supabase schema v_eval_ai (optional, falls back to DATABASE_URL)
GRAPH_DATABASE_URL=postgresql://postgres.zwxavhoszodmagisoiqu:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
